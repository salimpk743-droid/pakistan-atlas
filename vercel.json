{
  "cleanUrls": false,
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/province.html",
      "has": [
        {
          "type": "query",
          "key": "id",
          "value": "punjab"
        }
      ],
      "destination": "https://mybook.pk/punjab.html",
      "permanent": true
    },
