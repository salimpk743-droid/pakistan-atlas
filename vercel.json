    },
    {
      "source": "/districts-sindh.html",
      "destination": "https://mybook.pk/districts-of-sindh.html",
      "permanent": true
    },
    {
      "source": "/districts-of-pakistan.html",
      "destination": "https://mybook.pk/districts.html",
