{
  "cleanUrls": false,
  "trailingSlash": false,
  "redirects": [
    { "source": "/province.html", "has": [{ "type": "query", "key": "id", "value": "punjab" }], "destination": "/punjab.html", "permanent": true },
    { "source": "/province.html", "has": [{ "type": "query", "key": "id", "value": "sindh" }], "destination": "/sindh.html", "permanent": true },
    { "source": "/province.html", "has": [{ "type": "query", "key": "id", "value": "kpk" }], "destination": "/khyber-pakhtunkhwa.html", "permanent": true },
    { "source": "/province.html", "has": [{ "type": "query", "key": "id", "value": "balochistan" }], "destination": "/balochistan.html", "permanent": true },
    { "source": "/province.html", "has": [{ "type": "query", "key": "gb" }], "destination": "/gilgit-baltistan.html", "permanent": true },
    { "source": "/province.html", "has": [{ "type": "query", "key": "ajk" }], "destination": "/azad-kashmir.html", "permanent": true },
    { "source": "/province.html", "has": [{ "type": "query", "key": "id", "value": "ict" }], "destination": "/islamabad-capital-territory.html", "permanent": true }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "X-Frame-Options", "value": "SAMEORIGIN" }
      ]
    },
    {
      "source": "/css/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=86400" }]
    },
    {
      "source": "/js/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=86400" }]
    },
    {
      "source": "/images/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=604800" }]
    }
  ]
}
