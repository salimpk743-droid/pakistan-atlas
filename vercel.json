{
  "cleanUrls": false,
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/province.html",
      "has": [
        {
          "type": "query",
          "key": "id",
          "value": "punjab"
        }
      ],
      "destination": "https://mybook.pk/punjab.html",
      "permanent": true
    },
    {
      "source": "/province.html",
      "has": [
        {
          "type": "query",
          "key": "id",
          "value": "sindh"
        }
      ],
      "destination": "https://mybook.pk/sindh.html",
      "permanent": true
    },
    {
      "source": "/province.html",
      "has": [
        {
          "type": "query",
          "key": "id",
          "value": "kpk"
        }
      ],
      "destination": "https://mybook.pk/khyber-pakhtunkhwa.html",
      "permanent": true
    },
    {
      "source": "/province.html",
      "has": [
        {
          "type": "query",
          "key": "id",
          "value": "balochistan"
        }
      ],
      "destination": "https://mybook.pk/balochistan.html",
      "permanent": true
    },
    {
      "source": "/province.html",
      "has": [
        {
          "type": "query",
          "key": "id",
          "value": "gb"
        }
      ],
      "destination": "https://mybook.pk/gilgit-baltistan.html",
      "permanent": true
    },
    {
      "source": "/province.html",
      "has": [
        {
          "type": "query",
          "key": "id",
          "value": "ajk"
        }
      ],
      "destination": "https://mybook.pk/azad-kashmir.html",
      "permanent": true
    },
    {
      "source": "/province.html",
      "has": [
        {
          "type": "query",
          "key": "id",
          "value": "ict"
        }
      ],
      "destination": "https://mybook.pk/islamabad-capital-territory.html",
      "permanent": true
    },
    {
      "source": "/current-affairs.html",
      "destination": "https://mybook.pk/literature.html",
      "permanent": true
    },
    {
      "source": "/politics.html",
      "destination": "https://mybook.pk/geography.html",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "www.mybook.pk"
        }
      ],
      "destination": "https://mybook.pk/:path*",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        }
      ]
    },
    {
      "source": "/css/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/js/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400"
        }
      ]
    },
    {
      "source": "/images/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=2592000"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=2592000"
        }
      ]
    }
  ]
}
